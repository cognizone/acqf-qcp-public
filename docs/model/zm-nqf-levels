acqf-qcp-model:zm-nqf-levels
    a                  skos:ConceptScheme ;
    dct:title          "Revised National Qualifications Framework (NQF)"@en ;
    dct:description    "The revised Zambia National Qualifications Framework defines ten levels across general education, trades and occupations, and higher education, with learning outcomes expressed through knowledge, skills, and autonomy and responsibility."@en ;
    dct:created        "2026-04-17"^^xsd:date ;
    dct:publisher      "cognizone" ;
    dct:creator        "Petr Křemen" ;
