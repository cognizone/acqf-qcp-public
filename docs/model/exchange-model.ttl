_:cb20dc83e6a0c1b2d11dffcd6592ee98b4e483c6bae1b3ed51d350b761f202453f0 <http://www.w3.org/ns/shacl#message> "Qualification identifier notation {?value} must be unique within this upload."@en .
_:cb20dc83e6a0c1b2d11dffcd6592ee98b4e483c6bae1b3ed51d350b761f202453f0 <http://www.w3.org/ns/shacl#select> """
            PREFIX elm: <http://data.europa.eu/snb/model/elm/>
            PREFIX adms: <http://www.w3.org/ns/adms#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

            SELECT DISTINCT $this ?value
            WHERE {
                $this adms:identifier/skos:notation ?value .
                FILTER EXISTS {
                    ?other a elm:Qualification ;
                           adms:identifier/skos:notation ?otherValue .
                    FILTER (
                        $this != ?other &&
                        STR(?value) = STR(?otherValue)
                    )
                }
            }
        """ .
