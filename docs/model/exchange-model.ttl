        dc:description        "A legal person / registered organisation."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:OrganisationShape-location-Min1 , shape:OrganisationShape-prefLabel-Min1 , shape:identifierPropertyShape;
        sh:targetClass        elm:Organisation .

shape:QualificationShape-type
        rdf:type        sh:PropertyShape;
        sh:description  "The type of the qualifications. It should be provided using the ACQF Controlled List of Qualification Types."@en;
        sh:in           ( <https://data.acqf-qcp.africa/model/qualification-types/resource/full> <https://data.acqf-qcp.africa/model/qualification-types/resource/micro-credential> <https://data.acqf-qcp.africa/model/qualification-types/resource/partial> <https://data.acqf-qcp.africa/model/qualification-types/resource/recognition-of-prior-learning> );
