shape:AccreditationShape
        rdf:type              sh:NodeShape;
        dc:description        "The quality assurance or licensing of an organisation or a qualification. An accreditation instance can be used to specify information about: (1) the quality assurance and/or licensing of an organisation, (2) the quality assurance and/or licensing of an organisation with respect to a specific qualification."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:identifierPropertyShape , shape:AccreditationShape-accreditingAgent-Min1Max1 , shape:AccreditationShape-issueDate-Max1 , shape:AccreditationShape-organisation-Min1 , shape:titlePropertyShape-Min1 , shape:AccreditationShape-type-Min1Max1 , shape:AccreditationShape-reviewDate-Max1 , shape:AccreditationShape-expiryDate-Max1;
        sh:targetClass        elm:Accreditation .

shape:LearningOutcomeShape-relatedSkill
        rdf:type        sh:PropertyShape;
        sh:description  "A link to a related skill or the level of a related skill on a skill framework (except ESCO). It should be provided using a controlled vocabulary."@en;
