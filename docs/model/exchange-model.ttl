shape:ConceptShape-notation-Max1
        rdf:type        sh:PropertyShape;
        sh:description  "A notation, also known as classification code, is a string of characters used to uniquely identify a concept within the scope of a given concept scheme. This property is used to assign a notation as a typed literal."@en;
        sh:maxCount     1;
        sh:name         "notation"@en;
        sh:nodeKind     sh:Literal;
        sh:path         skos:notation;
        sh:severity     sh:Violation .

acqf-qcp-model:exchange-model
        rdf:type           owl:Ontology;
        cc:attributionURL  <http://ec.europa.eu/>;
        dc:created         "2024-04-03"^^xsd:date;
        dc:description     "This is the exchange data model of ACQF QCP. It provides a unified representation of qualifications and related notions across african countries in a human-readable and machine-readable form that serves as a basis for the ACQF platform as well as an exchange (import/export) format for sharing the ACQF data."@en;
        dc:license         <https://creativecommons.org/licenses/by/4.0/>;
        dc:modified        "2024-04-03"^^xsd:date;
        dc:publisher       <http://publications.europa.eu/resource/authority/corporate-body/ETF>;
        dc:title           "ACQF QCP Exchange Model"@en;
        owl:imports        elm:;
        owl:versionIRI     <https://data.acqf-qcp.africa/model/exchange-model/0.0.1>;
        owl:versionInfo    "0.0.1" .

shape:AccreditationShape-organisation-Min1
        rdf:type        sh:PropertyShape;
        sh:class        elm:Organisation;
        sh:description  "The organisation whose activities are being accredited."@en;
        sh:minCount     0;
        sh:name         "organisation"@en;
        sh:path         elm:organisation;
        sh:severity     sh:Violation .

shape:LearningEntitlementSpecificationShape-limitNationalOccupation
        rdf:type        sh:PropertyShape;
        sh:description  "An Occupation or Occupational Category. It should be provided using a controlled vocabulary."@en;
        sh:name         "limit national occupation"@en;
        sh:nodeKind     sh:IRI;
        sh:path         elm:limitNationalOccupation;
        sh:severity     sh:Violation;
        qcp:startsWith  "http://data.europa.eu/esco/occupation/" .

shape:ConceptSchemeShape
        rdf:type        sh:NodeShape;
        dc:description  "A controlled vocabulary modelled as a Concept Scheme."@en;
        sh:targetClass  skos:ConceptScheme .

shape:QualificationShape-awardingOpportunity-Min1
        rdf:type        sh:PropertyShape;
        sh:class        elm:AwardingOpportunity;
        sh:description  "Refers to  an activity related to the awarding of the qualification, such as the country or region where the qualification is awarded, the awarding body and optionally the awarding period now or in the past."@en;
        sh:minCount     1;
        sh:name         "awarding information"@en;
        sh:path         elm:awardingOpportunity;
        sh:severity     sh:Violation .

shape:UniqueQualificationNotationShape
        rdf:type        sh:NodeShape;
        sh:severity     sh:Violation;
        sh:sparql       [ rdf:type    sh:SPARQLConstraint;
                          sh:message  "Qualification identifier notation {?value} must be unique within this upload."@en;
                          sh:select   "\n            PREFIX elm: <http://data.europa.eu/snb/model/elm/>\n            PREFIX adms: <http://www.w3.org/ns/adms#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n\n            SELECT DISTINCT $this ?value\n            WHERE {\n                $this adms:identifier/skos:notation ?value .\n                FILTER EXISTS {\n                    ?other a elm:Qualification ;\n                           adms:identifier/skos:notation ?otherValue .\n                    FILTER (\n                        $this != ?other &&\n                        STR(?value) = STR(?otherValue)\n                    )\n                }\n            }\n        "
                        ];
        sh:targetClass  elm:Qualification .

shape:OrganisationShape-location-Min1
        rdf:type        sh:PropertyShape;
        sh:description  "The location of the organisation."@en;
        sh:minCount     1;
        sh:name         "location"@en;
        sh:path         elm:location;
        sh:severity     sh:Violation .
