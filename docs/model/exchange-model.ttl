shape:LearningOpportunityShape-defaultLanguage-Min1Max1
        rdf:type        sh:PropertyShape;
        sh:description  "The base language of the learning opportunity, to be considered authoritative."@en;
        sh:maxCount     1;
        sh:minCount     1;
        sh:name         "default language"@en;
        sh:nodeKind     sh:IRI;
        sh:path         elm:defaultLanguage;
        sh:severity     sh:Violation;
        qcp:startsWith  "http://publications.europa.eu/resource/authority/language/" .

shape:identifierPropertyShape
        rdf:type        sh:PropertyShape;
        sh:class        elm:Identifier;
        sh:description  "An identifier assigned to the resource."@en;
        sh:maxCount     1;
        sh:name         "identifier"@en;
        sh:path         adms:identifier;
        sh:severity     sh:Violation .

shape:NoteShape-noteFormat-Max1
        rdf:type        sh:PropertyShape;
        sh:description  "The format of the note. It should be provided using the IANA  types for text, text/plain, text/html etc."@en;
        sh:maxCount     1;
        sh:name         "note format"@en;
        sh:path         elm:noteFormat;
        sh:severity     sh:Violation .

shape:LocationShape  rdf:type  sh:NodeShape;
        dc:description        "An identifiable geographic place."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:LocationShape-spatialCode-Min1 , shape:identifierPropertyShape;
        sh:targetClass        dc:Location .

shape:IdentifierShape-notation-Min1Max1
        rdf:type        sh:PropertyShape;
