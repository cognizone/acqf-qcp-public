qcp:startsWithConstraintComponent
        rdf:type              sh:ConstraintComponent;
        sh:parameter          [ sh:datatype  xsd:string;
                                sh:name      "startsWith";
                                sh:path      qcp:startsWith
                              ];
        sh:propertyValidator  [ rdf:type    sh:SPARQLSelectValidator;
                                sh:message  "IRI does not start with the specified prefix.";
                                sh:select   "\n                SELECT $this ?value\n                WHERE {\n                    $this $PATH ?value .\n                    FILTER (!isIRI(?value) || !STRSTARTS(STR(?value), $startsWith))\n                }\n\t\t\t"
                              ] .

