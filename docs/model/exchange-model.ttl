shape:CreditPointShape-point-Min1Max1
        rdf:type        sh:PropertyShape;
        sh:datatype     xsd:double;
        sh:description  "The credit points assigned to the learning specification."@en;
        sh:maxCount     1;
        sh:minCount     1;
        sh:name         "points";
        sh:path         elm:point;
        sh:severity     sh:Violation .

shape:CreditPointShape
        rdf:type              sh:NodeShape;
        dc:description        "The credit Points"@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:CreditPointShape-point-Min1Max1 , shape:CreditPointShape-framework-Min1Max1;
        sh:targetClass        elm:CreditPoint .

shape:NoteShape-noteLiteral-Min1
        rdf:type        sh:PropertyShape;
        sh:datatype     rdf:langString;
        sh:description  "The textual content of the note."@en;
        sh:minCount     1;
        sh:name         "note literal"@en;
        sh:path         elm:noteLiteral;
        sh:severity     sh:Violation .

shape:homepagePropertyShape
        rdf:type        sh:PropertyShape;
        sh:class        elm:WebResource;
        sh:description  "The homepage."@en;
        sh:name         "homepage"@en;
        sh:node         shape:URLRegexRestriction;
        sh:path         foaf:homepage;
        sh:severity     sh:Violation .

shape:LearningEntitlementSpecificationShape
        rdf:type              sh:NodeShape;
        dc:description        "The specification of a right a person has access to, typically as a result of a learning achievement. It may take the form of the right to be a member of an organisation, to follow a certain learning opportunity specification, or to follow a certain career. Learning Entitlement Specifications is a subclass of Specification."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:LearningEntitlementSpecificationShape-limitNationalOccupation , shape:identifierPropertyShape;
        sh:targetClass        elm:LearningEntitlementSpecification .

shape:AccreditationShape-reviewDate-Max1
        rdf:type        sh:PropertyShape;
        sh:datatype     xsd:dateTime;
        sh:description  "The date when the accreditation has to be reviewed."@en;
        sh:maxCount     1;
        sh:name         "review date"@en;
        sh:path         elm:reviewDate;
        sh:severity     sh:Violation .

shape:URLRegexRestriction
        rdf:type        sh:NodeShape;
        dc:description  "This shape does not apply on a class. This shape is for checking if the value of contentUrl is well formed."@en;
        sh:property     [ sh:and       ( [ sh:pattern  "^(?i)(http|https):(//(([^@\\[/?#]*)@)?(\\[[[A-Fa-f0-9]\\:\\.]*[%[\\p{L}\\p{Nl}\\p{Nd}]]*\\]|[^\\[/?#:]*)(:(\\d*(?:\\{[^/]+?\\})?))?)?([^?#]*)(\\?([^#]*))?(#(.*))?" ]
                                         [ sh:pattern  "^(([^:/?#]+):)?(//([^/?#]*))?([^?#]*)(\\?([^#]*))?(#(.*))?" ]
                                       );
                          sh:path      elm:contentUrl;
                          sh:severity  sh:Violation
                        ] .

shape:IdentifierShape
        rdf:type              sh:NodeShape;
        dc:description        "A character string used to identify a resource. An identifier is a character string used to uniquely identify one instance of an object within an identification scheme that is managed by an agency. The Identifier class is a critical aspect of the ELM. It is used to identify persons and organisations. In these cases, and more, the identifier itself will be some sort of alpha-numeric string but that string only has meaning if it is contextualised."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:IdentifierShape-schemeName-Max1 , shape:IdentifierShape-schemeAgency-Max1 , shape:IdentifierShape-notation-Min1Max1;
        sh:targetClass        elm:Identifier .

shape:QualificationShape-entitlesTo
        rdf:type        sh:PropertyShape;
        sh:class        elm:LearningEntitlementSpecification;
        sh:description  "Rights (such as which the person may acquire as a result of acquiring the learning outcomes)."@en;
        sh:name         "entitles To"@en;
        sh:path         elm:entitlesTo;
        sh:severity     sh:Violation .

shape:AccreditationShape-type-Min1Max1
        rdf:type        sh:PropertyShape;
        sh:description  "The type of the accreditation. It should be provided using the EDC Controlled List of Accreditation Types."@en;
        sh:in           ( <https://data.acqf-qcp.africa/model/accreditation-types/resource/approval> <https://data.acqf-qcp.africa/model/accreditation-types/resource/eqar-institutional-accreditation> <https://data.acqf-qcp.africa/model/accreditation-types/resource/eqar-programme-accreditation> <https://data.acqf-qcp.africa/model/accreditation-types/resource/institutional-license> <https://data.acqf-qcp.africa/model/accreditation-types/resource/institutional-quality-assurance> <https://data.acqf-qcp.africa/model/accreditation-types/resource/licensing> <https://data.acqf-qcp.africa/model/accreditation-types/resource/programme-license> <https://data.acqf-qcp.africa/model/accreditation-types/resource/programme-quality-assurance> <https://data.acqf-qcp.africa/model/accreditation-types/resource/registration> );
        sh:maxCount     1;
        sh:minCount     1;
        sh:name         "type"@en;
        sh:nodeKind     sh:IRI;
        sh:path         dc:type;
        sh:severity     sh:Violation;
        qcp:startsWith  "https://data.acqf-qcp.africa/model/accreditation-types/resource/" .

shape:AwardingOpportunityShape-awardingBody-Min1
        rdf:type        sh:PropertyShape;
        sh:class        elm:Organisation;
        sh:description  "The awarding body related to this awarding activity (i.e., the organisation that issues the qualification) Only in cases of co-awarding/co-graduation, where a qualification is issued to an individual by two or more organisations the cardinality is greater than 1."@en;
        sh:minCount     1;
        sh:name         "awarding body"@en;
        sh:path         elm:awardingBody;
        sh:severity     sh:Violation .

shape:NoteShape-subject-Max1
        rdf:type        sh:PropertyShape;
        sh:description  "The subject of the note. It should be provided using a controlled vocabulary."@en;
        sh:maxCount     1;
        sh:name         "subject"@en;
        sh:path         dc:subject;
        sh:severity     sh:Violation .

shape:AwardingOpportunityShape
        rdf:type              sh:NodeShape;
        dc:description        "An awarding opportunity describes how, where, from whom and when a claim may be obtained."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:AwardingOpportunityShape-awardingBody-Min1 , shape:additionalNotePropertyShape , shape:identifierPropertyShape;
        sh:targetClass        elm:AwardingOpportunity .

shape:IdentifierShape-schemeName-Max1
        rdf:type        sh:PropertyShape;
        sh:datatype     xsd:string;
        sh:description  "The name of the identifier scheme."@en;
        sh:maxCount     1;
        sh:name         "scheme name"@en;
        sh:path         elm:schemeName;
        sh:severity     sh:Violation .

shape:ConceptShape-altLabel
        rdf:type        sh:PropertyShape;
        sh:datatype     rdf:langString;
        sh:description  "The alternative name. It must be disjoint with name (skos:prefLabel) of the Concept."@en;
        sh:disjoint     skos:prefLabel;
        sh:name         "alternative name"@en;
        sh:path         skos:altLabel;
        sh:severity     sh:Violation .

shape:QualificationShape-learningOutcomeSummary-Max1
        rdf:type        sh:PropertyShape;
        sh:class        elm:Note;
        sh:description  "The full learning outcome summary of the qualification."@en;
        sh:maxCount     1;
        sh:name         "learning outcome summary"@en;
        sh:path         elm:learningOutcomeSummary;
        sh:severity     sh:Violation .

shape:NoteShape  rdf:type     sh:NodeShape;
        dc:description        "Free text metadata fields, such as the description, a historical or additional note of a qualification can contain a plain text or a XHTML fragment as literal value. By using a Note both the datatype of the literal and the language can be specified."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:NoteShape-noteFormat-Max1 , shape:NoteShape-subject-Max1 , shape:NoteShape-noteLiteral-Min1;
        sh:targetClass        elm:Note .

shape:publisherPropertyShape-Min1Max1
        rdf:type        sh:PropertyShape;
        sh:class        elm:Organisation;
        sh:description  "The publisher."@en;
        sh:maxCount     1;
        sh:minCount     1;
        sh:name         "publisher"@en;
        sh:path         dc:publisher;
        sh:severity     sh:Violation .

shape:IdentifierShape-schemeAgency-Max1
        rdf:type        sh:PropertyShape;
        sh:datatype     rdf:langString;
        sh:description  "The name of the agent that manages the identifier scheme."@en;
        sh:name         "scheme agency name"@en;
        sh:path         adms:schemeAgency;
        sh:severity     sh:Violation;
        sh:uniqueLang   true .

shape:QualificationShape-learningOutcome-Min1
        rdf:type        sh:PropertyShape;
        sh:class        elm:LearningOutcome;
        sh:description  "An individual (expected) learning outcome of the qualification."@en;
        sh:minCount     1;
        sh:name         "learning outcome"@en;
        sh:path         elm:learningOutcome;
        sh:severity     sh:Violation .

shape:ConceptShape  rdf:type  sh:NodeShape;
        dc:description  "A term from a controlled vocabulary modelled as a skos:Concept."@en;
        sh:property     shape:ConceptShape-inScheme , shape:ConceptShape-notation-Max1 , shape:ConceptShape-altLabel , shape:ConceptShape-prefLabel;
        sh:targetClass  skos:Concept .

shape:titlePropertyShape-Min1
        rdf:type        sh:PropertyShape;
        sh:datatype     rdf:langString;
        sh:description  "The title. One value per language is permitted."@en;
        sh:minCount     1;
        sh:name         "title"@en;
        sh:path         dc:title;
        sh:severity     sh:Violation;
        sh:uniqueLang   true .

shape:WebResource-contentUrl-Min1Max1
        rdf:type        sh:PropertyShape;
        sh:description  "The public access URL."@en;
        sh:maxCount     1;
        sh:minCount     1;
        sh:name         "URL"@en;
        sh:path         elm:contentUrl;
        sh:severity     sh:Violation .

shape:WebResourceShape
        rdf:type              sh:NodeShape;
        dc:description        "A public web resource."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:WebResource-contentUrl-Min1Max1;
        sh:targetClass        elm:WebResource .

shape:LearningOpportunityShape
        rdf:type              sh:NodeShape;
        dc:description        "An opportunity to realise a given set of learning outcomes via a learning activity and/or assessment."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type );
        sh:property           shape:LearningOpportunityShape-providedBy-Min1 , shape:LearningOpportunityShape-defaultLanguage-Min1Max1 , shape:LearningOpportunityShape-learningAchievementSpecification-Min1Max1 , shape:identifierPropertyShape , shape:titlePropertyShape-Min1;
        sh:targetClass        elm:LearningOpportunity .

shape:QualificationShape-educationLevelAcqf
        rdf:type        sh:PropertyShape;
        sh:description  "An associated level of education within ACQF education levels."@en;
        sh:in           ( <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-1> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-10> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-2> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-3> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-4> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-5> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-6> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-7> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-8> <https://data.acqf-qcp.africa/model/acqf-levels/resource/level-9> );
        sh:minCount     0;
        sh:name         "education level (ACQF)"@en;
        sh:nodeKind     sh:IRI;
        sh:path         elm-extension:educationLevelAcqf;
        sh:severity     sh:Violation;
        qcp:startsWith  "https://data.acqf-qcp.africa/model/acqf-levels/resource/" .

shape:QualificationShape-additionalNote
        rdf:type        sh:PropertyShape;
        sh:class        elm:Note;
        sh:description  "An additional free text note about the resource. Can be used e.g. for qualification objectives."@en;
        sh:name         "more information"@en;
        sh:path         elm:additionalNote;
        sh:severity     sh:Violation .

shape:QualificationShape-isPartOf
        rdf:type        sh:PropertyShape;
        sh:class        elm:Qualification;
        sh:description  "Links the qualification to its master qualification (of which one this is part of)."@en;
        sh:maxCount     1;
        sh:name         "is part of"@en;
        sh:path         elm:isPartOf;
        sh:severity     sh:Violation .

shape:QualificationShape
        rdf:type              sh:NodeShape;
        dc:description        "A specification of an assessment and validation process which is obtained when a competent authority determines that an individual has achieved learning outcomes to given standards. Qualification is a subclass of Learning Achievement Specification."@en;
        sh:closed             true;
        sh:ignoredProperties  ( rdf:type elm-extension:learningOpportunity );
        sh:property           shape:QualificationShape-awardingOpportunity-Min1 , shape:QualificationShape-educationLevelNqf , shape:QualificationShape-educationLevelAcqf , shape:identifierPropertyShape , shape:QualificationShape-ISCEDFCode , shape:QualificationShape-entryRequirement , shape:QualificationShape-creditPoint , shape:QualificationShape-accreditation , shape:QualificationShape-type , shape:QualificationShape-additionalNote , shape:homepagePropertyShape , shape:QualificationShape-learningOutcomeSummary-Max1 , shape:titlePropertyShape-Min1 , shape:publisherPropertyShape-Min1Max1 , shape:QualificationShape-learningOutcome-Min1 , shape:QualificationShape-isPartOf , shape:QualificationShape-supplementaryDocument , shape:QualificationShape-volumeOfLearning , shape:QualificationShape-entitlesTo;
        sh:targetClass        elm:Qualification .

shape:QualificationShape-ISCEDFCode
