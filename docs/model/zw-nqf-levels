    a                  skos:ConceptScheme ;
    dct:title          "Zimbabwe National Qualifications Framework levels and level descriptors"@en ;
    dct:description    "This is a SKOS representation of the ZNQF levels and level descriptors."@en ;
    dct:created        "2024-06-25"^^xsd:date ;
    dct:publisher      "cognizone bv" ;
    dct:creator        "Petr Křemen" ;
