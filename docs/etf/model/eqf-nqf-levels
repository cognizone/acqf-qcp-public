                "2026-09-16"^^<http://www.w3.org/2001/XMLSchema#date> .

<http://data.europa.eu/snb/eqf/note_06bcf8519f>
        rdf:type   <http://publications.europa.eu/ontology/euvoc#XlNote>;
        rdf:value  "Zaawansowana wiedza w danej dziedzinie pracy lub nauki obejmująca krytyczne rozumienie teorii i zasad zaawansowane umiejętności, wykazywanie się biegłością i innowacyjnością potrzebną do rozwiązania złożonych i nieprzewidywalnych problemów w specjalistycznej dziedzinie pracy lub nauki zarządzanie złożonymi technicznymi lub zawodowymi działaniami lub projektami, przyjmowanie odpowiedzialności za podejmowanie decyzji w nieprzewidywalnych kontekstach związanych z pracą lub nauką przyjmowanie odpowiedzialności za zarządzanie rozwojem zawodowym jednostek i grup."@pl;
