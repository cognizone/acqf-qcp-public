        rdf:type   <http://publications.europa.eu/ontology/euvoc#XlNote>;
        rdf:value  "Conocimiento de hechos, principios, procesos y conceptos generales en un campo del trabajo o estudio concreto Gama de capacidades cognitivas y prácticas necesarias para efectuar tareas y resolver problemas seleccionando y aplicando métodos, herramientas, materiales e información básica Asunción de responsabilidades para realizar tareas en actividades de trabajo o estudio Adaptación del comportamiento propio a las circunstancias para resolver problemas."@es;
