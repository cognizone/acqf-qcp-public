<https://data.acqf-qcp.africa/model/exchange-model/resource/UniqueQualificationNotationShape>
        a       <http://www.w3.org/ns/shacl#NodeShape>;
        <http://www.w3.org/ns/shacl#severity>
                <http://www.w3.org/ns/shacl#Violation>;
        <http://www.w3.org/ns/shacl#sparql>
                [ a       <http://www.w3.org/ns/shacl#SPARQLConstraint>;
                  <http://www.w3.org/ns/shacl#message>
                          "Qualification identifier notation {?value} must be unique within this upload."@en;
                  <http://www.w3.org/ns/shacl#select>
                          "\n            PREFIX elm: <http://data.europa.eu/snb/model/elm/>\n            PREFIX adms: <http://www.w3.org/ns/adms#>\n            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n\n            SELECT DISTINCT $this ?value\n            WHERE {\n                $this adms:identifier/skos:notation ?value .\n                FILTER EXISTS {\n                    ?other a elm:Qualification ;\n                           adms:identifier/skos:notation ?otherValue .\n                    FILTER (\n                        $this != ?other &&\n                        STR(?value) = STR(?otherValue)\n                    )\n                }\n            }\n        "
                ];
        <http://www.w3.org/ns/shacl#targetClass>
                <http://data.europa.eu/snb/model/elm/Qualification> .

