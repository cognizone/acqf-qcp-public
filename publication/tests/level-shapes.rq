PREFIX sh: <http://www.w3.org/ns/shacl#>
CONSTRUCT {
  ?s ?p ?o .
  <https://data.acqf-qcp.africa/model/exchange-model/resource/QualificationShape-educationLevelNqf>
    sh:targetClass <urn:test:case:LevelCase> .
} WHERE {
  ?s ?p ?o
  FILTER (?p NOT IN (sh:targetNode, sh:targetClass, sh:targetSubjectsOf, sh:targetObjectsOf, <http://www.w3.org/2002/07/owl#imports>))
}
