PREFIX qcp: <https://data.acqf-qcp.africa/model/internal/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT DISTINCT ?scheme ?graph WHERE {
  ?shape qcp:controlledVocabularyCatalogue ?catalogue .
  ?member skos:inScheme ?catalogue ; dct:relation ?scheme .
  OPTIONAL { GRAPH ?graph { ?scheme a skos:ConceptScheme } }
}
ORDER BY STR(?scheme)
