PREFIX p: <urn:publication:graph:>
PREFIX qcp: <https://data.acqf-qcp.africa/model/internal/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
CONSTRUCT { ?shape qcp:controlledVocabulary ?scheme }
WHERE {
  VALUES ?part { p:common p:profile }
  ?part p:source ?graph .
  { GRAPH ?graph { ?shape qcp:controlledVocabulary ?scheme } }
  UNION {
    GRAPH ?graph { ?shape qcp:controlledVocabularyCatalogue ?catalogue }
    p:vocabulary p:source ?source .
    GRAPH ?source { ?catalogue a skos:ConceptScheme . ?member skos:inScheme ?catalogue; dct:relation ?scheme }
  }
}
